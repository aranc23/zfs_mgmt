#!/usr/bin/env ruby
require "thor"
require "zfs_mgmt"
require "zfs_mgmt/restic"
require "zfs_mgmt/zfs_mgr"
require "zfs_mgmt/zfs_mgr/restic"

class ZfsMgr < Thor
  class_option :zfs_binary, :type => :string, :default => 'zfs',
               :desc => 'zfs binary'
  class_option :zpool_binary, :type => :string, :default => 'zpool',
               :desc => 'zpool binary'
  class_option :mbuffer_binary, :type => :string, :default => 'mbuffer',
               :desc => 'mbuffer binary'
  class_option :pv_binary, :type => :string, :default => 'pv',
               :desc => 'pv binary'
  class_option :loglevel, :type => :string,
               :default => ( (ENV['ZFS_MGMT_LOGLEVEL'] && !ENV['ZFS_MGMT_LOGLEVEL'].empty?) ? ENV['ZFS_MGMT_LOGLEVEL'].downcase : ( $stdout.isatty ? 'info' : 'warn' ) ),
               :enum => ['debug','error','fatal','info','warn','unknown','none','off','silent'],
               :desc => 'set logging level to specified severity'
  class_option :lock, :type => :boolean, :default => false,
               :desc => 'lock before running'
  class_option :lock_file, :type => :string, :default => '/run/zfsmgr.lock',
               :desc => 'lock file'
  class_option :lock_wait, :type => :numeric, :default => 0,
               :desc => 'wait N seconds for lock'
  class_option :config_dir, :type => :string,
               :desc => 'directory containing zfsmgr .toml config files'
  desc "zfsget [ZFS]", "execute zfs get for the given properties and types and parse the output into a nested hash"
  method_option :properties, :type => :string, :default => ['name'], :desc => "List of properties passed to zfs get", repeatable: true
  method_option :types,      :type => :array, :default => ['filesystem','volume'], enum: ['filesystem','volume','snapshot'], :desc => "list of types"
  def zfsget(zfs)
    ZfsMgmt.set_log_level(options[:loglevel])
    ZfsMgmt.global_options = options
    ZfsMgmt.load_config
    pp ZfsMgmt.zfsget(properties: options[:properties],
                      types: options[:types],
                      zfs: zfs)
  end
  desc "snapshot SUBCOMMAND ...ARGS", "manage snapshots"
  subcommand "snapshot", ZfsMgmt::ZfsMgr::Snapshot
  desc "list SUBCOMMAND ...ARGS", "list filesystems"
  subcommand "list", ZfsMgmt::ZfsMgr::List
  desc "restic SUBCOMMAND ...ARGS", "backup zfs to restic"
  subcommand "restic", ZfsMgmt::ZfsMgr::Restic
  desc "send SUBCOMMAND ...ARGS", "send zfs"
  subcommand "send", ZfsMgmt::ZfsMgr::Send
  desc "recv SUBCOMMAND ...ARGS", "receive zfs"
  subcommand "recv", ZfsMgmt::ZfsMgr::Recv
  desc "config SUBCOMMAND ...ARGS", "manage and validate zfsmgr configuration"
  subcommand "config", ZfsMgmt::ZfsMgr::Config

  desc "schema", "print the config JSON schema (or its installed file path with --path)"
  method_option :path, :type => :boolean, :default => false,
                :desc => "print the path to the bundled config.schema.json file"
  def schema
    if options[:path]
      puts ZfsMgmt::Config.schema_path
    else
      path = ZfsMgmt::Config.schema_path
      if File.exist?(path)
        puts File.read(path)
      else
        puts JSON.pretty_generate(ZfsMgmt::Config.config_json_schema)
      end
    end
  end

  map '--version' => :version
  desc "version", "print zfs_mgmt version"
  def version
    puts "zfsmgr #{ZfsMgmt::VERSION}"
  end
end

ZfsMgr.start(ARGV)
